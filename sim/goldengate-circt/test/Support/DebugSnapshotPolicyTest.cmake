# The small target deliberately stops at the no-data-channel FAME diagnostic.
# The switch must change only optional MLIR, preserving transformations,
# annotations, required FIRRTL output and failure diagnostics byte-for-byte.
if(NOT DEFINED COMPILER OR NOT DEFINED WORK)
  message(FATAL_ERROR "COMPILER and WORK required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${WORK}/${suffix}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/input.fir" "FIRRTL version 1.2.0\ncircuit Snapshot:\n  module Snapshot:\n    input clock : Clock\n    skip\n")
file(WRITE "${work}/input.json" [=[
[{"class":"midas.passes.fame.FAMEChannelConnectionAnnotation",
  "globalName":"clocks","sinks":["~Snapshot|Snapshot>clock"],
  "channelInfo":{"class":"midas.passes.fame.TargetClockChannel",
    "clockInfo":[{"name":"base","multiplier":1,"divisor":1}],
    "perClockMFMR":[1]}}]
]=])
foreach(mode baseline debug diagnostic stop)
  if(mode STREQUAL "diagnostic")
    set(flags --disable-autocounter)
  elseif(mode STREQUAL "debug")
    set(flags --compile-baseline --emit-debug-snapshots)
  elseif(mode STREQUAL "stop")
    set(flags --compile-baseline --stop-after-print-host-binding)
  else()
    set(flags --compile-baseline)
  endif()
  execute_process(COMMAND "${COMPILER}" "${work}/input.fir"
    --annotation-file "${work}/input.json" --output-dir "${work}/${mode}" ${flags}
    RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_VARIABLE output TIMEOUT 15)
  file(WRITE "${work}/${mode}.log" "${output}\n${error}")
  if(mode STREQUAL "baseline" OR mode STREQUAL "debug" OR mode STREQUAL "stop")
    if(NOT result EQUAL 1 OR NOT error MATCHES "FAME model has no data channels")
      message(FATAL_ERROR "${mode} changed compiler boundary: ${result}\n${output}\n${error}")
    endif()
    if(mode STREQUAL "baseline")
      set(baseline_error "${error}")
    elseif(NOT error STREQUAL baseline_error)
      message(FATAL_ERROR "snapshot/stop flag changed failure diagnostic")
    endif()
  elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "diagnostic failed: ${result}\n${error}")
  endif()
  file(GLOB snapshots "${work}/${mode}/*.mlir")
  if(mode STREQUAL "baseline")
    if(snapshots)
      message(FATAL_ERROR "normal baseline serialized optional MLIR: ${snapshots}")
    endif()
  elseif(NOT snapshots)
    message(FATAL_ERROR "${mode} did not retain diagnostic snapshots")
  endif()
endforeach()
file(GLOB collateral RELATIVE "${work}/baseline" "${work}/baseline/*")
list(LENGTH collateral count)
if(count LESS 10)
  message(FATAL_ERROR "fixture did not reach enough compiler stages")
endif()
foreach(file IN LISTS collateral)
  file(SHA256 "${work}/baseline/${file}" baseline_hash)
  file(SHA256 "${work}/debug/${file}" debug_hash)
  if(NOT baseline_hash STREQUAL debug_hash)
    message(FATAL_ERROR "snapshot flag changed required collateral ${file}")
  endif()
endforeach()
message(STATUS "Optional MLIR switch preserves ${count} required boundary outputs and diagnostic/stop snapshots")
